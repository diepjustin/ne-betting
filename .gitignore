.env
.venv/
__pycache__/
*.pyc
.pytest_cache/
data/raw/
data/husker.db

# Derived analysis output. Rebuilt by `python -m analysis.breakdown` in
# seconds, and player_props.csv names individual athletes, which plan section
# 9 keeps out of anything published.
data/analysis/
data/sample/recon/*.log
data/state/*.log

# Collector watermarks. These live in the Actions cache, not in git: at the
# wide scope the file tracks 22,564 markets, and a multi-megabyte file
# rewritten by a daily commit is how a repository's history gets heavy.
data/state/*.json

# R writes these into whatever directory it is started in
.Rhistory
.RData
